<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="23127194 Stress 20260812 - Scenario C" enabled="true">
      <stringProp name="TestPlan.comments">Phase 3 progressive stress contract derived from measured Load evidence: maximum 80 VUs, 240 s linear ramp-up, 300 s flow-start deadline, 250 ms think-time. Analyze active-thread bands 1-20, 21-40, 41-60, and 61-80. Aggregate Report is the Stress listener; raw JTL and HTML report remain authoritative.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Reviewed Acceptance Criteria" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="threshold.http_error_percent" elementType="Argument"><stringProp name="Argument.name">threshold.http_error_percent</stringProp><stringProp name="Argument.value">1.0</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="threshold.business_success_percent" elementType="Argument"><stringProp name="Argument.name">threshold.business_success_percent</stringProp><stringProp name="Argument.value">99.0</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="threshold.end_to_end_p95_ms" elementType="Argument"><stringProp name="Argument.name">threshold.end_to_end_p95_ms</stringProp><stringProp name="Argument.value">250</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="threshold.transaction_p95_ms" elementType="Argument"><stringProp name="Argument.name">threshold.transaction_p95_ms</stringProp><stringProp name="Argument.value">100</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"/>
    </TestPlan>
    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Unmeasured Setup - Validate Reviewed Runtime Properties" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Setup Loop" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"/><stringProp name="ThreadGroup.delay"/>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Validate required load properties and CSV capacity" enabled="true">
          <stringProp name="scriptLanguage">beanshell</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">false</stringProp>
          <stringProp name="script"><![CDATA[
String failMessage = "";
String[] requiredPositive = {"stress.threads", "stress.ramp_up_seconds", "stress.duration_seconds"};
for (int index = 0; index < requiredPositive.length; index++) {
    String name = requiredPositive[index];
    String value = props.getProperty(name);
    if (value == null || !value.matches("[1-9][0-9]*")) {
        failMessage = "Missing or invalid -J" + name + "; expected a positive integer";
        break;
    }
}
String think = props.getProperty("stress.think_time_ms");
if (failMessage.length() == 0 && (think == null || !think.matches("[0-9]+"))) {
    failMessage = "Missing or invalid -Jstress.think_time_ms; expected a non-negative integer";
}
java.io.File csv = new java.io.File(System.getProperty("user.dir"), "data/scenario-c.local.csv");
int availableRows = 0;
if (failMessage.length() == 0 && !csv.isFile()) {
    failMessage = "Missing data/scenario-c.local.csv; provision users after backend reset";
}
if (failMessage.length() == 0) {
    java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.InputStreamReader(new java.io.FileInputStream(csv), "UTF-8"));
    while (reader.readLine() != null) availableRows++;
    reader.close();
    availableRows = availableRows > 0 ? availableRows - 1 : 0;
    int threads = Integer.parseInt(props.getProperty("stress.threads"));
    if (availableRows < threads) {
        failMessage = "CSV has " + availableRows + " users but stress.threads=" + threads + "; require USER_COUNT >= threads";
    }
}
if (failMessage.length() > 0) {
    SampleResult.setSuccessful(false);
    SampleResult.setResponseCode("500");
    SampleResult.setResponseMessage(failMessage);
} else {
    long deadline = System.currentTimeMillis() + (Long.parseLong(props.getProperty("stress.duration_seconds")) * 1000L);
    props.setProperty("stress.deadline_ms", Long.toString(deadline));
    SampleResult.setSuccessful(true);
    SampleResult.setResponseCode("200");
    SampleResult.setResponseMessage("Validated runtime properties against " + availableRows + " CSV rows; graceful flow deadline initialized");
}
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Measured Stress - Scenario C" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">startnextloop</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Assign CSV Once Per Thread" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp>
