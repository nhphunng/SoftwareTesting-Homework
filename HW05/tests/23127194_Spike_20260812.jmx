        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="01 Baseline Stage - Initialize Deadline" enabled="true">
          <stringProp name="scriptLanguage">beanshell</stringProp>
          <stringProp name="parameters" />
          <stringProp name="filename" />
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">String deadlineName = "spike.baseline.deadline_ms";
long now = System.currentTimeMillis();
synchronized (props) {
    String prior = props.getProperty(deadlineName);
    if (prior == null || Long.parseLong(prior) &lt;= now) {
        long deadline = now + (Long.parseLong(props.getProperty("spike.baseline_duration_seconds")) * 1000L);
        props.setProperty(deadlineName, Long.toString(deadline));
    }
}
SampleResult.setSuccessful(true);
SampleResult.setResponseCode("200");
SampleResult.setResponseMessage("Baseline stage deadline initialized");</stringProp>
        </JSR223Sampler>
