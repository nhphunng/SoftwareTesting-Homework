                </elementProp>
                <stringProp name="HTTPSampler.path">/api/checkout</stringProp>
                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              </HTTPSamplerProxy>
              <hashTree>
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 200 - Checkout" enabled="true">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="200">200</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                  <boolProp name="Assertion.assume_success">false</boolProp>
                  <intProp name="Assertion.test_type">8</intProp>
                </ResponseAssertion>
                <hashTree />
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract orderId" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">orderId</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.orderId</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues">__MISSING_ORDER_ID__</stringProp>
                </JSONPostProcessor>
                <hashTree />
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Business - Checkout returns fresh order ID" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters" />
                  <stringProp name="filename" />
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">def id=vars.get('orderId');if(!id||id=='__MISSING_ORDER_ID__'||!(id==~/[1-9][0-9]*/)){AssertionResult.setFailure(true);AssertionResult.setFailureMessage('Positive orderId missing')}</stringProp>
                </JSR223Assertion>
                <hashTree />
              </hashTree>
            </hashTree>
            <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="03 Recovery | 05 Transactional Order Lifecycle" enabled="true">
              <boolProp name="TransactionController.includeTimers">false</boolProp>
              <boolProp name="TransactionController.parent">false</boolProp>
            </TransactionController>
            <hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="03 Recovery | 07 Read Fresh Order" enabled="true">
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments" />
                </elementProp>
                <stringProp name="HTTPSampler.path">/api/orders/${orderId}</stringProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              </HTTPSamplerProxy>
              <hashTree>
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 200 - Read Fresh Order" enabled="true">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="200">200</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                  <boolProp name="Assertion.assume_success">false</boolProp>
                  <intProp name="Assertion.test_type">8</intProp>
                </ResponseAssertion>
                <hashTree />
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Business - Fresh order is pending" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters" />
                  <stringProp name="filename" />
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">def b=new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString());if((b.id as String)!=vars.get('orderId')||b.status!='pending'){AssertionResult.setFailure(true);AssertionResult.setFailureMessage('Fresh order is not the correlated pending order')}</stringProp>
                </JSR223Assertion>
                <hashTree />
              </hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="03 Recovery | 08 Cancel Fresh Order" enabled="true">
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments" />
                </elementProp>
                <stringProp name="HTTPSampler.path">/api/orders/${orderId}/cancel</stringProp>
                <stringProp name="HTTPSampler.method">PUT</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              </HTTPSamplerProxy>
              <hashTree>
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 200 - Cancel Fresh Order" enabled="true">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="200">200</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                  <boolProp name="Assertion.assume_success">false</boolProp>
                  <intProp name="Assertion.test_type">8</intProp>
                </ResponseAssertion>
                <hashTree />
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Business - Cancel accepted" enabled="true">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="canceled">Order canceled successfully</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                  <boolProp name="Assertion.assume_success">false</boolProp>
                  <intProp name="Assertion.test_type">16</intProp>
                </ResponseAssertion>
                <hashTree />
              </hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="03 Recovery | 09 Verify Canceled History" enabled="true">
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments" />
                </elementProp>
                <stringProp name="HTTPSampler.path">/api/orders/my-orders</stringProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              </HTTPSamplerProxy>
              <hashTree>
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 200 - Verify Canceled History" enabled="true">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="200">200</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                  <boolProp name="Assertion.assume_success">false</boolProp>
                  <intProp name="Assertion.test_type">8</intProp>
                </ResponseAssertion>
                <hashTree />
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Business - Same order is canceled" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters" />
                  <stringProp name="filename" />
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">def b=new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString());def id=vars.get('orderId');if(!(b instanceof List)||!b.any{(it.id as String)==id&amp;&amp;it.status=='canceled'}){AssertionResult.setFailure(true);AssertionResult.setFailureMessage('Same correlated order is not canceled in history')}</stringProp>
                </JSR223Assertion>
                <hashTree />
              </hashTree>
            </hashTree>
          </hashTree>
        </hashTree>
      </hashTree>
